# 复制为 .env 后按需修改（.env 不提交到仓库）
NEXPLM_DB_NAME=nexplm
NEXPLM_DB_USER=nexplm
NEXPLM_DB_PASSWORD=nexplm
NEXPLM_DB_PORT=5432

NEXPLM_REDIS_PORT=6379

NEXPLM_MINIO_USER=nexplm
NEXPLM_MINIO_PASSWORD=nexplm12345
NEXPLM_MINIO_PORT=9000
NEXPLM_MINIO_CONSOLE_PORT=9001

# 文件仓：storage=local 用本地磁盘（开发默认），storage=minio 用对象存储（生产推荐）
NEXPLM_FILE_STORAGE=local
NEXPLM_FILE_ROOT=./data/files
# 以下仅在 storage=minio 时生效，access/secret 须与上面的 MINIO_USER/PASSWORD 一致
NEXPLM_MINIO_ENDPOINT=http://minio:9000
NEXPLM_MINIO_ACCESS_KEY=nexplm
NEXPLM_MINIO_SECRET_KEY=nexplm12345
NEXPLM_MINIO_BUCKET=nexplm

NEXPLM_MQ_USER=nexplm
NEXPLM_MQ_PASSWORD=nexplm12345
NEXPLM_MQ_PORT=5672
NEXPLM_MQ_CONSOLE_PORT=15672
